// The signal, in three.js. A searchlight sits low right in the frame: a drum, a lens, a yoke. It flickers to life
// already sweeping the sky, searching, then eases onto one spot of cloud and holds. The beam is a cone that leaves
// at the lens's width, with particles riding it on the GPU; the disc of light follows wherever the beam lands, and
// once the beam is locked TRM's mark gathers out of dots inside it, then the real white mark (unaltered, as the
// brand guidelines ask) settles on top. The camera drifts with the pointer. Falls back to signal.js without WebGL.
(function () {
  const host = document.querySelector(".trm-signal");
  if (!host || typeof THREE === "undefined") return;
  const canvas = host.querySelector("canvas"), copy = host.querySelector(".trm-signal-copy");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let renderer;
  try { renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false, powerPreference: "high-performance" }); }
  catch (e) { return; }
  window.__trmSignal3D = true;
  renderer.setPixelRatio(Math.min(2, devicePixelRatio || 1));
  const scene = new THREE.Scene();
  scene.background = new THREE.Color("#00124D");
  const camera = new THREE.PerspectiveCamera(42, 2, 0.1, 400);
  camera.position.set(0, 0, 70);
  const CYAN = new THREE.Color("#06E4F9");
  const rnd = (a, b) => a + Math.random() * (b - a);
  const ease = (x) => 1 - Math.pow(1 - Math.min(1, Math.max(0, x)), 3);
  const U = { time: { value: 0 }, intensity: { value: still ? 1 : 0 } };

  // ---- where things are. The lamp sits low right; the beam is L long; the disc is wherever it lands.
  const LAMP = new THREE.Vector3(27, -24, 2), TARGET = new THREE.Vector3(-14, 8, -22), DISC_R = 14, LENS_R = 2.4;
  const L = TARGET.distanceTo(LAMP);
  const qBase = new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0, 1, 0), TARGET.clone().sub(LAMP).normalize());

  // ---- sky and cloud
  const sky = new THREE.Mesh(new THREE.PlaneGeometry(400, 240), new THREE.ShaderMaterial({
    uniforms: U, depthWrite: false,
    vertexShader: "varying vec2 vUv; void main(){ vUv=uv; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0); }",
    fragmentShader: "varying vec2 vUv; void main(){ gl_FragColor=vec4(mix(vec3(0.0,0.07,0.30),vec3(0.012,0.043,0.18),vUv.y),1.0); }",
  }));
  sky.position.z = -120; scene.add(sky);
  const softTex = (() => {
    const c = document.createElement("canvas"); c.width = c.height = 256; const g = c.getContext("2d");
    const r = g.createRadialGradient(128, 128, 0, 128, 128, 128); r.addColorStop(0, "rgba(255,255,255,1)"); r.addColorStop(0.5, "rgba(255,255,255,0.35)"); r.addColorStop(1, "rgba(255,255,255,0)");
    g.fillStyle = r; g.fillRect(0, 0, 256, 256); return new THREE.CanvasTexture(c);
  })();
  const clouds = [];
  for (let i = 0; i < 9; i++) {
    const s = new THREE.Sprite(new THREE.SpriteMaterial({ map: softTex, color: new THREE.Color("#4F6AC2"), transparent: true, opacity: rnd(0.05, 0.12), depthWrite: false }));
    const sc = rnd(50, 110); s.position.set(rnd(-120, 120), rnd(-20, 60), rnd(-90, -30)); s.scale.set(sc * 1.8, sc, 1); s.userData.v = rnd(0.4, 1.2) * (i % 2 ? 1 : -1);
    scene.add(s); clouds.push(s);
  }

  // ---- the searchlight: a group at the lamp whose local +Y is the beam. Yaw and pitch turn it.
  const light = new THREE.Group(); light.position.copy(LAMP); scene.add(light);
  scene.add(new THREE.AmbientLight("#8FA3D9", 0.35));
  const key = new THREE.DirectionalLight("#CFD8FF", 0.9); key.position.set(-30, 40, 50); scene.add(key);
  const metal = new THREE.MeshStandardMaterial({ color: "#1B2642", metalness: 0.75, roughness: 0.38 });
  const drum = new THREE.Mesh(new THREE.CylinderGeometry(LENS_R * 1.08, LENS_R * 1.25, 5.2, 48), metal); drum.position.y = -2.6; light.add(drum);
  const ring = new THREE.Mesh(new THREE.TorusGeometry(LENS_R * 1.08, 0.22, 12, 48), new THREE.MeshStandardMaterial({ color: "#3B4A75", metalness: 0.8, roughness: 0.3 }));
  ring.rotation.x = Math.PI / 2; ring.position.y = 0.02; light.add(ring);
  const lensMat = new THREE.MeshBasicMaterial({ color: "#FFFFFF", transparent: true, opacity: 0 });
  const lens = new THREE.Mesh(new THREE.CircleGeometry(LENS_R, 48), lensMat); lens.rotation.x = -Math.PI / 2; lens.position.y = 0.05; light.add(lens);
  const lensGlow = new THREE.Sprite(new THREE.SpriteMaterial({ map: softTex, color: "#BFF6FF", transparent: true, opacity: 0, depthWrite: false, blending: THREE.AdditiveBlending }));
  lensGlow.scale.set(9, 9, 1); lensGlow.position.y = 0.6; light.add(lensGlow);
  const lamp = new THREE.PointLight("#06E4F9", 0, 60, 2); lamp.position.y = 1.5; light.add(lamp);
  // the yoke and post, so it reads as a thing standing on something, mostly below the frame
  const yoke = new THREE.Mesh(new THREE.TorusGeometry(LENS_R * 1.5, 0.3, 10, 40, Math.PI), metal); yoke.rotation.z = Math.PI; yoke.position.y = -2.6; light.add(yoke);
  const post = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.7, 16, 16), metal); post.position.set(LAMP.x, LAMP.y - 12, LAMP.z); scene.add(post);

  // ---- the beam: a cone from the lens, soft at its edge, fading along its length, shimmering in the dust
  const coneGeo = new THREE.CylinderGeometry(DISC_R * 1.05, LENS_R, L, 56, 1, true); coneGeo.translate(0, L / 2, 0);
  const cone = new THREE.Mesh(coneGeo, new THREE.ShaderMaterial({
    uniforms: U, transparent: true, depthWrite: false, side: THREE.DoubleSide, blending: THREE.AdditiveBlending,
    vertexShader: "varying vec2 vUv; varying vec3 vN; varying vec3 vV; void main(){ vUv=uv; vN=normalize(normalMatrix*normal); vec4 mv=modelViewMatrix*vec4(position,1.0); vV=normalize(-mv.xyz); gl_Position=projectionMatrix*mv; }",
    fragmentShader: `uniform float intensity; uniform float time; varying vec2 vUv; varying vec3 vN; varying vec3 vV;
      void main(){ float rim=pow(abs(dot(vN,vV)),0.9); float along=1.0-vUv.y;
        float dust=0.86+0.14*sin(vUv.y*38.0-time*5.0)*sin(vUv.x*14.0+time*2.3);
        float a=intensity*(0.06+0.32*along*along)*rim*dust; gl_FragColor=vec4(0.024,0.894,0.976,a); }`,
  }));
  light.add(cone);
  const N = 2400, pGeo = new THREE.BufferGeometry();
  const at = new Float32Array(N), ang = new Float32Array(N), rad = new Float32Array(N), spd = new Float32Array(N), sz = new Float32Array(N);
  for (let i = 0; i < N; i++) { at[i] = Math.random(); ang[i] = rnd(0, 6.283); rad[i] = Math.pow(Math.random(), 0.6); spd[i] = rnd(0.5, 1.3); sz[i] = rnd(0.6, 1.8); }
  pGeo.setAttribute("position", new THREE.BufferAttribute(new Float32Array(N * 3), 3));
  pGeo.setAttribute("aT", new THREE.BufferAttribute(at, 1)); pGeo.setAttribute("aA", new THREE.BufferAttribute(ang, 1));
  pGeo.setAttribute("aR", new THREE.BufferAttribute(rad, 1)); pGeo.setAttribute("aS", new THREE.BufferAttribute(spd, 1)); pGeo.setAttribute("aZ", new THREE.BufferAttribute(sz, 1));
  pGeo.boundingSphere = new THREE.Sphere(new THREE.Vector3(0, L / 2, 0), L);
  const pMat = new THREE.ShaderMaterial({
    uniforms: { ...U, len: { value: L }, r0: { value: LENS_R }, rEnd: { value: DISC_R }, dpr: { value: renderer.getPixelRatio() } },
    transparent: true, depthWrite: false, blending: THREE.AdditiveBlending,
    vertexShader: `uniform float time; uniform float len; uniform float r0; uniform float rEnd; uniform float dpr;
      attribute float aT; attribute float aA; attribute float aR; attribute float aS; attribute float aZ; varying float vA;
      void main(){ float t=fract(aT+time*0.05*aS); float w=r0+(rEnd-r0)*t; vec3 p=vec3(cos(aA)*aR*w, t*len, sin(aA)*aR*w);
        p.x+=sin(time*1.3+aA*7.0)*0.25; vec4 mv=modelViewMatrix*vec4(p,1.0); gl_Position=projectionMatrix*mv;
        gl_PointSize=aZ*dpr*(140.0/-mv.z); vA=(0.25+0.75*(1.0-aR))*(0.55+0.45*sin(time*2.0+aA*5.0)); }`,
    fragmentShader: `uniform float intensity; varying float vA; void main(){ vec2 c=gl_PointCoord-0.5; float d=length(c); if(d>0.5) discard; gl_FragColor=vec4(0.024,0.894,0.976,intensity*vA*smoothstep(0.5,0.15,d)); }`,
  });
  light.add(new THREE.Points(pGeo, pMat));

  // ---- the disc on the cloud, wherever the beam lands: the bright rim, the scalloped dotted ring, the mark
  const discGroup = new THREE.Group(); scene.add(discGroup);
  discGroup.add(new THREE.Mesh(new THREE.CircleGeometry(DISC_R, 64), new THREE.ShaderMaterial({
    uniforms: U, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending,
    vertexShader: "varying vec2 vUv; void main(){ vUv=uv; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0); }",
    fragmentShader: `uniform float intensity; varying vec2 vUv; void main(){ float d=length(vUv-0.5)*2.0; float a=intensity*(0.10+0.14*smoothstep(0.6,0.96,d))*smoothstep(1.0,0.92,d); gl_FragColor=vec4(0.024,0.894,0.976,a); }`,
  })));
  const RIM = 220, rimGeo = new THREE.BufferGeometry(), rimPos = new Float32Array(RIM * 3);
  rimGeo.setAttribute("position", new THREE.BufferAttribute(rimPos, 3));
  const rimMat = new THREE.PointsMaterial({ color: CYAN, size: 0.42, transparent: true, opacity: 0, depthWrite: false, blending: THREE.AdditiveBlending });
  discGroup.add(new THREE.Points(rimGeo, rimMat));
  // TRM's mark, sampled from the official vector into dot targets, then the mark itself as a sprite
  const mk = document.createElement("canvas"); mk.width = 600; mk.height = 600; const mg = mk.getContext("2d");
  const path = new Path2D(host.dataset.mark || "");
  mg.fillStyle = "#fff"; mg.fill(path);
  let bx0 = 600, by0 = 600, bx1 = 0, by1 = 0;
  { const d = mg.getImageData(0, 0, 600, 600).data; for (let y = 0; y < 600; y++) for (let x = 0; x < 600; x++) if (d[(y * 600 + x) * 4 + 3] > 10) { bx0 = Math.min(bx0, x); by0 = Math.min(by0, y); bx1 = Math.max(bx1, x); by1 = Math.max(by1, y); } }
  const bw = bx1 - bx0, bh = by1 - by0, S = 440 / Math.max(bw, bh);
  mg.clearRect(0, 0, 600, 600); mg.save(); mg.translate(300 - (bx0 + bw / 2) * S, 300 - (by0 + bh / 2) * S); mg.scale(S, S); mg.fillStyle = "#fff"; mg.fill(path); mg.restore();
  const targets = [];
  { const d = mg.getImageData(0, 0, 600, 600).data; for (let y = 0; y < 600; y += 9) for (let x = 0; x < 600; x += 9) if (d[(y * 600 + x) * 4 + 3] > 120) targets.push([(x - 300) / 300, -(y - 300) / 300]); }
  const M = targets.length, mGeo = new THREE.BufferGeometry(), mPos = new Float32Array(M * 3), mStart = targets.map(() => [rnd(-1.8, 1.8), rnd(-1.8, 1.8)]);
  mGeo.setAttribute("position", new THREE.BufferAttribute(mPos, 3));
  const mMat = new THREE.PointsMaterial({ color: "#F7F7F7", size: 0.36, transparent: true, opacity: 0, depthWrite: false });
  discGroup.add(new THREE.Points(mGeo, mMat));
  const markSprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: new THREE.CanvasTexture(mk), transparent: true, opacity: 0, depthWrite: false }));
  const MR = DISC_R * 0.56; markSprite.scale.set(MR * 2 * 600 / 440, MR * 2 * 600 / 440, 1); markSprite.position.z = 0.5; discGroup.add(markSprite);

  // ---- what the beam passes on its way: silhouettes that exist only while the light is on them
  const silTex = (draw) => { const c = document.createElement("canvas"); c.width = 256; c.height = 256; const g = c.getContext("2d"); g.fillStyle = "#BFF3FA"; g.strokeStyle = "#BFF3FA"; draw(g); return new THREE.CanvasTexture(c); };
  const birdTex = silTex((g) => { g.lineWidth = 14; g.lineCap = "round"; g.beginPath(); g.moveTo(20, 150); g.quadraticCurveTo(80, 70, 128, 130); g.quadraticCurveTo(176, 70, 236, 150); g.stroke(); });
  const figureTex = silTex((g) => { g.beginPath(); g.arc(128, 70, 34, 0, 7); g.fill(); g.beginPath(); g.moveTo(60, 250); g.quadraticCurveTo(64, 120, 128, 108); g.quadraticCurveTo(192, 120, 196, 250); g.closePath(); g.fill();
    g.beginPath(); g.moveTo(96, 86); g.quadraticCurveTo(128, 20, 160, 86); g.quadraticCurveTo(128, 60, 96, 86); g.fill(); });   // a hood
  const things = [];
  const thing = (tex, x, y, z, w, h, v) => { const sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, opacity: 0, depthWrite: false, blending: THREE.AdditiveBlending })); sp.position.set(x, y, z); sp.scale.set(w, h, 1); sp.userData.v = v || 0; scene.add(sp); things.push(sp); return sp; };
  // the sweep, before it locks: the same arcs the frame uses, so figures can be placed where the beam will pass
  const sweep = (t) => ({ yaw: 0.5 * Math.sin(t * 0.9) + 0.12 * Math.sin(t * 2.7), pitch: 0.22 * Math.sin(t * 1.4 + 1.0) });
  const aimLight = (yo, po) => { light.quaternion.copy(qBase); light.rotateZ(yo); light.rotateX(po); light.updateMatrixWorld(); };
  const endAt = (t) => { const a = sweep(t); aimLight(a.yaw, a.pitch); const e = new THREE.Vector3(0, L, 0); light.localToWorld(e); return e; };
  for (const [t, dx, dy, w] of [[1.6, -3, -6, 7], [2.9, 4, -7, 8]]) { const e = endAt(t); thing(figureTex, e.x + dx, e.y + dy, e.z + 0.6, w, w, 0); }
  // a flock crossing the sky; the beam catches them as they pass
  const flock = [];
  for (let i = 0; i < 7; i++) { const b = thing(birdTex, rnd(-60, -20) - i * 6, rnd(14, 30), rnd(-26, -18), rnd(2.6, 4.2), rnd(1.6, 2.6), rnd(9, 14)); b.userData.ph = rnd(0, 6.3); flock.push(b); }

  // ---- time. Dark; the lamp stutters on while already sweeping; it searches past what is out there; it locks; the mark gathers.
  function flicker(s) {
    if (still) return 1;
    if (s < 0.5) return 0;
    if (s < 1.7) { const k = (s - 0.5) / 1.2; const burst = Math.sin(s * 47) * Math.sin(s * 23) > 0.15 ? 1 : 0.08; return Math.min(1, burst * (0.4 + 0.6 * k)); }
    return 0.97 + 0.03 * Math.sin(s * 31) * Math.sin(s * 17);   // the hum of a lamp that is on
  }
  let t0 = performance.now(), px = 0, py = 0, tx = 0, ty = 0;
  host.addEventListener("pointermove", (e) => { const b = host.getBoundingClientRect(); tx = ((e.clientX - b.left) / b.width - 0.5) * 2; ty = ((e.clientY - b.top) / b.height - 0.5) * 2; });
  function resize() { const b = host.getBoundingClientRect(); renderer.setSize(b.width, b.height, false); camera.aspect = b.width / b.height; camera.updateProjectionMatrix(); pMat.uniforms.dpr.value = renderer.getPixelRatio(); }
  const endLocal = new THREE.Vector3(0, L, 0), endWorld = new THREE.Vector3(), dir = new THREE.Vector3(), normal = new THREE.Vector3();
  function frame(now) {
    const s = still ? 9 : (now - t0) / 1000;
    const I = flicker(s), lock = ease((s - 4.2) / 1.3), on = ease((s - 5.5) / 0.6), gather = ease((s - 5.6) / 1.5), solid = ease((s - 7.2) / 0.8);
    U.time.value = s; U.intensity.value = I;
    // the search: wide slow arcs while it warms, narrowing onto the aim as it locks, then a breath of drift
    const sw = sweep(s);
    const yaw = sw.yaw * (1 - lock) + 0.012 * Math.sin(s * 0.7) * lock, pitch = sw.pitch * (1 - lock) + 0.008 * Math.sin(s * 0.9 + 2.0) * lock;
    aimLight(yaw, pitch);
    // the disc sits where the beam ends, tilted like cloud, facing partly back to the camera
    endWorld.copy(endLocal); light.localToWorld(endWorld); discGroup.position.copy(endWorld);
    dir.copy(endWorld).sub(LAMP).normalize(); normal.copy(dir).negate().lerp(new THREE.Vector3(0, 0, 1), 0.4).normalize();
    discGroup.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), normal);
    // the flock flies on; anything inside the disc of light shows, and fades as the beam moves off it
    for (const b of flock) { b.position.x += b.userData.v * 0.016; b.position.y += Math.sin(s * 2.2 + b.userData.ph) * 0.02; if (b.position.x > 90) b.position.x = -90; b.scale.y = Math.abs(b.scale.y) * (Math.sin(s * 9 + b.userData.ph) > 0 ? 1 : 0.75); }
    for (const t of things) { const d = t.position.distanceTo(endWorld); t.material.opacity = 0.75 * I * Math.max(0, 1 - d / (DISC_R * 1.05)); }
    for (const c of clouds) { c.position.x += c.userData.v * 0.016; if (c.position.x > 140) c.position.x = -140; if (c.position.x < -140) c.position.x = 140; c.material.opacity = (0.05 + 0.07 * I) * 0.9; }
    for (let i = 0; i < RIM; i++) { const a = (i / RIM) * 6.283 + s * 0.05, r = DISC_R * (0.97 + 0.03 * Math.sin(a * 12)); rimPos[i * 3] = Math.cos(a) * r; rimPos[i * 3 + 1] = Math.sin(a) * r; rimPos[i * 3 + 2] = 0.2; }
    rimGeo.attributes.position.needsUpdate = true; rimMat.opacity = 0.9 * I;
    for (let i = 0; i < M; i++) { const [sx, sy] = mStart[i], [ex, ey] = targets[i]; mPos[i * 3] = (sx * (1 - gather) + ex * gather) * MR; mPos[i * 3 + 1] = (sy * (1 - gather) + ey * gather) * MR; mPos[i * 3 + 2] = 0.4; }
    mGeo.attributes.position.needsUpdate = true; mMat.opacity = on * (1 - solid); markSprite.material.opacity = solid;
    lensMat.opacity = 0.95 * I; lensGlow.material.opacity = 0.8 * I; lamp.intensity = 220 * I;
    px += (tx - px) * 0.05; py += (ty - py) * 0.05;
    camera.position.x = px * 3; camera.position.y = -py * 2; camera.lookAt(0, 0, -20);
    if (copy) copy.style.opacity = still ? 1 : ease((s - 6.0) / 0.9);
    renderer.render(scene, camera);
    if (!still) requestAnimationFrame(frame);
  }
  resize(); new ResizeObserver(resize).observe(host);
  const start = () => { t0 = performance.now(); if (still) frame(0); else requestAnimationFrame(frame); };
  start();
  host.querySelector(".trm-signal-replay")?.addEventListener("click", start);
})();
